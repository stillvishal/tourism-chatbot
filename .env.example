# Copy this file to ".env" (same folder), keep ONE option, and restart uvicorn.
# If you leave LLM_PROVIDER unset, the chat uses the offline "Basic mode" bot.

# ---- OPTION A: Ollama (100% free, runs on your own PC, no internet/key needed) ----
# 1) Install from https://ollama.com   2) In a terminal run:  ollama pull llama3.1:8b
#    (low RAM? use a smaller model: ollama pull llama3.2:3b  and set LLM_MODEL below)
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b

# ---- OPTION B: Groq (free tier, fast, no credit card; needs internet) ----
# Get a free key at https://console.groq.com -> API Keys
# LLM_PROVIDER=groq
# LLM_API_KEY=paste-your-groq-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# ---- OPTION C: any other OpenAI-compatible service (OpenRouter, Gemini, LM Studio...) ----
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=...
# LLM_MODEL=...
